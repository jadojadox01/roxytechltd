# Required Vercel environment variables (Production)
# Import .env OR add these manually in Vercel → Settings → Environment Variables

DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require
NEXTAUTH_URL=https://naalvastore.vercel.app
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
SITE_NAME=NAALVA STORE
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Order emails (required for place-order + confirmed PDF receipt emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=niyomuhozajeandedieu80@gmail.com
EMAIL_PASSWORD=your_16_char_gmail_app_password
EMAIL_FROM="NAALVA STORE" <niyomuhozajeandedieu80@gmail.com>
EMAIL_REPLY_TO=niyomuhozajeandedieu80@gmail.com

# Login will FAIL with "Server error" if NEXTAUTH_SECRET or NEXTAUTH_URL is missing.
# Order emails are skipped (with a server log warning) if EMAIL_* vars are missing.
