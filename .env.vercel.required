# Required Vercel environment variables (Production)
# Import .env OR add these manually in Vercel → Settings → Environment Variables
# Production site: https://www.roxin.rw/

DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require
NEXTAUTH_URL=https://www.roxin.rw
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
SITE_NAME=ROXY TECH
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Emails via Resend (forgot password + order confirmation)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Roxin.rw <beth.t@example.com>"
EMAIL_REPLY_TO=hello@roxin.rw
ORDER_NOTIFY_EMAIL=roxinrw@gmail.com

# Login will FAIL with "Server error" if NEXTAUTH_SECRET or NEXTAUTH_URL is missing.
# Verify roxin.rw in Resend, then set EMAIL_FROM="Roxin.rw <noreply@roxin.rw>"
# Image uploads require Cloudinary vars (already configured in local .env).
# After changing DATABASE_URL on Vercel, run: npx prisma migrate deploy
