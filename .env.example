# Copy to .env.local for local dev — never commit real secrets
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ecommerce?schema=public
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-string-min-32-characters

SITE_NAME=Your Store Name

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Order emails (Gmail App Password recommended — not your normal password)
# Google Account → Security → 2-Step Verification → App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=niyomuhozajeandedieu80@gmail.com
EMAIL_PASSWORD=your_16_char_app_password
EMAIL_FROM="NAALVA STORE" <niyomuhozajeandedieu80@gmail.com>
EMAIL_REPLY_TO=niyomuhozajeandedieu80@gmail.com
